#include <winver.h>

IDI_ICON1 ICON "@TOFFEE_RC_ICON@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@TOFFEE_RC_DESCRIPTION@"
            VALUE "FileVersion", "@TOFFEE_VERSION_STRING@"
            VALUE "InternalName", "@TOFFEE_RC_FILE_NAME@"
            VALUE "LegalCopyright", "Copyright (C) 2026 Gavin Walsh. GPL-3.0."
            VALUE "OriginalFilename", "@TOFFEE_RC_FILE_NAME@"
            VALUE "ProductName", "Toffee"
            VALUE "ProductVersion", "@TOFFEE_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

@TOFFEE_RC_ENCODER@
