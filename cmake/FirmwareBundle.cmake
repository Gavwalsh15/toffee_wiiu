# Embeds the bridge firmware and esptool.exe that tools/package-firmware.ps1 writes, so the app's
# Flash ESP page can flash the board. esptool's licence goes into the release's firmware zip.
set(TOFFEE_FIRMWARE_BUNDLE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/build/firmware-app" CACHE PATH
    "Directory generated by tools/package-firmware.ps1")
set(_firmware_embedded manifest.json esptool.exe bootloader.bin partition-table.bin firmware.bin)
set(_firmware_licenses esptool-LICENSE.txt)

set(_firmware_missing)
foreach(_name IN LISTS _firmware_embedded _firmware_licenses)
    if(NOT EXISTS "${TOFFEE_FIRMWARE_BUNDLE_DIR}/${_name}")
        list(APPEND _firmware_missing "${_name}")
    endif()
endforeach()

if(_firmware_missing)
    message(FATAL_ERROR "The firmware bundle in ${TOFFEE_FIRMWARE_BUNDLE_DIR} is missing "
                        "${_firmware_missing}. Run tools/package-firmware.ps1 first.")
endif()

set(_firmware_files)
foreach(_name IN LISTS _firmware_embedded)
    set(_file "${TOFFEE_FIRMWARE_BUNDLE_DIR}/${_name}")
    set_source_files_properties("${_file}" PROPERTIES QT_RESOURCE_ALIAS "${_name}")
    list(APPEND _firmware_files "${_file}")
endforeach()
qt_add_resources(toffee firmware_bundle PREFIX "/firmware" FILES ${_firmware_files})
message(STATUS "Bundling ESP32-C5 firmware and esptool from ${TOFFEE_FIRMWARE_BUNDLE_DIR}")
