CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_TOFFEE_PROFILE is not set
CONFIG_TOFFEE_VIDEO_HOLD_FRAMES=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# Wi-Fi sends fail when the driver runs out of RAM for queued packets (about 1.6 KB each), and a
# 64 KB picture buffer leaves little heap. The GamePad sends us little, so fewer always-allocated
# RX buffers (no fewer than RX_BA_WIN) and keeping the Wi-Fi RX path out of RAM free about 28 KB.
# On the ESP32-C5, code placed in IRAM comes out of the same SRAM as the heap.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
# Experimental: aggregate video packets so large pictures take less airtime. If the GamePad
# declines aggregation the driver sends packets one at a time, as with this off. The GamePad
# offered a window of 8.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=8
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_PAIRING=y
CONFIG_ZERO_BOARD=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
